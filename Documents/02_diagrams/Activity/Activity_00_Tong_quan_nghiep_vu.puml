@startuml
title Activity Diagram - Quy trình nghiệp vụ tổng quan NaviMart

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor black
skinparam activity {
  BackgroundColor #FFF8CC
  BorderColor black
  FontColor black
  DiamondBackgroundColor #FFF8CC
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Người dùng|
start
:Đăng nhập hoặc đăng ký tài khoản;
:Thiết lập hoặc tham gia nhóm gia đình;

if (Có nhu cầu đi chợ?) then ([Có])
  :Tạo/cập nhật danh sách mua sắm;
  :Đánh dấu các mặt hàng đã mua;
  |Hệ thống|
  :Chuyển mặt hàng đã mua\n vào tủ lạnh/kho thực phẩm;
else ([Không])
endif

|Người dùng|
if (Có nhu cầu quản lý thực phẩm?) then ([Có])
  :Xem, thêm, cập nhật\n hoặc thanh lý thực phẩm;
  |Hệ thống|
  :Theo dõi hạn sử dụng;
  :Thông báo thực phẩm sắp hết hạn;
else ([Không])
endif

|Người dùng|
if (Có nhu cầu chuẩn bị bữa ăn?) then ([Có])
  :Lên kế hoạch bữa ăn\n hoặc yêu cầu gợi ý món ăn;
  |Hệ thống AI|
  :Gợi ý món ăn/công thức\n dựa trên Pantry;
  |Người dùng|
  :Chọn món ăn hoặc công thức;
  |Hệ thống|
  :Kiểm tra nguyên liệu;
  if (Thiếu nguyên liệu?) then ([Có])
    |Người dùng|
    :Thêm nguyên liệu thiếu\n vào danh sách mua sắm;
  else ([Không])
    :Xác nhận nấu ăn;
    |Hệ thống|
    :Tự động trừ thực phẩm\n đã dùng trong kho;
  endif
else ([Không])
endif

|Người dùng|
:Xem thống kê tiêu dùng và lãng phí;
stop
@enduml
