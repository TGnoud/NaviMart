@startuml
title Activity Diagram - Quy trình xác thực và quản lý tài khoản

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor black
skinparam activity {
  BackgroundColor #FFF8CC
  BorderColor black
  FontColor black
  DiamondBackgroundColor #FFF8CC
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Khách|
start
:Mở ứng dụng NaviMart;

if (Đã có tài khoản?) then ([Chưa])
  :Chọn đăng ký tài khoản;
  :Nhập thông tin đăng ký;
  |Hệ thống|
  :Kiểm tra thông tin đăng ký;
  if (Thông tin hợp lệ?) then ([Có])
    :Tạo tài khoản mới;
    |Khách|
    :Nhận thông báo đăng ký thành công;
  else ([Không])
    :Nhận thông báo lỗi đăng ký;
    stop
  endif
else ([Có])
endif

|Khách|
if (Đăng nhập qua mạng xã hội?) then ([Có])
  :Chọn nhà cung cấp mạng xã hội;
  |Hệ thống|
  :Xác thực qua nhà cung cấp;
else ([Không])
  |Người dùng|
  :Nhập Email/SĐT và mật khẩu;
  |Hệ thống|
  :Kiểm tra thông tin đăng nhập;
endif

if (Xác thực thành công?) then ([Có])
  |Người dùng|
  :Truy cập hệ thống;
  if (Cần quản lý tài khoản?) then ([Có])
    :Xem/cập nhật thông tin cá nhân;
    :Đổi mật khẩu hoặc đăng xuất khi cần;
  else ([Không])
  endif
  stop
else ([Không])
  |Hệ thống|
  :Thông báo đăng nhập thất bại;
  |Người dùng|
  if (Quên mật khẩu?) then ([Có])
    :Yêu cầu đặt lại mật khẩu;
    |Hệ thống|
    :Xác minh và cho phép đổi mật khẩu;
  else ([Không])
  endif
  stop
endif
@enduml
