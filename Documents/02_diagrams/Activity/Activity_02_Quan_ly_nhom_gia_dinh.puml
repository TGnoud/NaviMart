@startuml
title Activity Diagram - Quy trình quản lý nhóm gia đình

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor black
skinparam activity {
  BackgroundColor #FFF8CC
  BorderColor black
  FontColor black
  DiamondBackgroundColor #FFF8CC
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Người dùng|
start
:Mở chức năng quản lý nhóm gia đình;

if (Đã thuộc nhóm gia đình?) then ([Có])
  :Xem thông tin nhóm\n và danh sách thành viên;
  if (Muốn rời khỏi nhóm?) then ([Có])
    :Chọn rời khỏi nhóm;
    |Hệ thống|
    :Cập nhật trạng thái thành viên;
    |Người dùng|
    :Nhận thông báo đã rời nhóm;
  else ([Không])
    if (Cần mời thêm thành viên?) then ([Có])
      :Tạo mã mời;
      |Hệ thống|
      :Sinh mã mời/link mời;
      |Người dùng|
      :Chia sẻ mã mời cho thành viên;
    else ([Không])
    endif

    if (Cần cập nhật phân quyền?) then ([Có])
      :Chọn thành viên và quyền mới;
      |Hệ thống|
      :Lưu thay đổi phân quyền;
    else ([Không])
    endif
  endif
else ([Không])
  if (Có mã mời?) then ([Có])
    :Nhập mã mời để tham gia nhóm;
    |Hệ thống|
    :Kiểm tra mã mời;
    if (Mã mời hợp lệ?) then ([Có])
      :Thêm người dùng vào nhóm;
    else ([Không])
      :Thông báo mã mời không hợp lệ;
    endif
  else ([Không])
    |Người dùng|
    :Tạo nhóm gia đình mới;
    |Hệ thống|
    :Khởi tạo nhóm gia đình;
  endif
endif

|Người dùng|
:Xem trạng thái nhóm sau cập nhật;
stop
@enduml
