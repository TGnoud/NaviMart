@startuml
title Activity Diagram - Quy trình quản lý tủ lạnh và kho thực phẩm

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor black
skinparam activity {
  BackgroundColor #FFF8CC
  BorderColor black
  FontColor black
  DiamondBackgroundColor #FFF8CC
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Người dùng|
start
:Mở chức năng quản lý tủ lạnh;

if (Nguồn nhập thực phẩm?) then ([Sau khi mua])
  |Hệ thống|
  :Tự động lấy thực phẩm từ\n danh sách mua sắm đã mua;
else ([Thủ công])
  |Người dùng|
  :Nhập thực phẩm thủ công;
  :Nhập tên, số lượng,\n hạn dùng, vị trí;
endif

|Hệ thống|
:Chuẩn hóa thông tin thực phẩm;
while (Dữ liệu hợp lệ?) is ([Không])
  :Hiển thị thông báo lỗi;
  |Người dùng|
  :Nhập lại thông tin thực phẩm;
  |Hệ thống|
  :Kiểm tra lại dữ liệu;
endwhile ([Có])

:Lưu thực phẩm vào kho;

fork
  |Người dùng|
  :Xem và tìm kiếm thực phẩm;
  if (Hành động của người dùng?) then ([Nấu])
    :Xác nhận món ăn đã nấu;
    |Hệ thống|
    :Đối chiếu nguyên liệu với kho;
    :Tự động trừ số lượng thực phẩm;
    if (Nguyên liệu đã cạn?) then ([Có])
      |Người dùng|
      :Nhận cảnh báo nguyên liệu đã cạn;
    else ([Không])
    endif
  else ([Sửa/Xóa])
    |Người dùng|
    :Cập nhật hoặc thanh lý thực phẩm;
    |Hệ thống|
    :Lưu thay đổi kho thực phẩm;
  endif
fork again
  |Hệ thống|
  :Quét hạn sử dụng hằng ngày;
  if (Có thực phẩm sắp hết hạn?) then ([Có])
    :Gửi thông báo sắp hết hạn;
    |Người dùng|
    :Xem cảnh báo và xử lý thực phẩm;
  else ([Không])
  endif
end fork

|Hệ thống|
:Cập nhật trạng thái kho;
stop
@enduml
