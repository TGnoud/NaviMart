@startuml
title Activity Diagram - Quy trình lên kế hoạch bữa ăn

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor black
skinparam activity {
  BackgroundColor #FFF8CC
  BorderColor black
  FontColor black
  DiamondBackgroundColor #FFF8CC
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Người dùng|
start
:Mở chức năng lên kế hoạch bữa ăn;
:Xem lịch trình hiện tại;

if (Cần tạo phiên ăn?) then ([Có])
  :Tạo phiên ăn mới;
  |Hệ thống|
  :Lưu phiên ăn vào lịch trình;
else ([Không])
endif

|Người dùng|
:Thêm món ăn vào phiên ăn;

if (Cần chỉnh sửa món ăn?) then ([Có])
  :Sửa món ăn trong lịch trình;
else ([Không])
endif

if (Cần xóa món ăn?) then ([Có])
  :Xóa món ăn khỏi lịch trình;
else ([Không])
endif

|Hệ thống|
:Kiểm tra nguyên liệu cần cho lịch trình;
if (Thiếu nguyên liệu?) then ([Có])
  |Người dùng|
  :Thêm nguyên liệu thiếu\n vào danh sách mua sắm;
  |Hệ thống|
  :Cập nhật danh sách mua sắm;
else ([Không])
  :Đánh dấu lịch trình sẵn sàng;
endif

|Người dùng|
:Xem kế hoạch bữa ăn đã cập nhật;
stop
@enduml
