@startuml
title Activity Diagram - Quy trình gợi ý món ăn và công thức nấu ăn

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor black
skinparam activity {
  BackgroundColor #FFF8CC
  BorderColor black
  FontColor black
  DiamondBackgroundColor #FFF8CC
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Người dùng|
start
:Mở chức năng gợi ý món ăn/công thức;

if (Muốn tìm công thức thủ công?) then ([Có])
  :Nhập từ khóa tìm kiếm;
  |Hệ thống|
  :Trả về danh sách công thức phù hợp;
  |Người dùng|
  :Xem chi tiết công thức;
else ([Không])
  :Yêu cầu gợi ý món ăn theo Pantry;
  |Hệ thống AI|
  :Đọc dữ liệu Pantry;
  :Gợi ý món ăn phù hợp;
  |Người dùng|
  :Chọn món ăn được gợi ý;
endif

if (Cần trao đổi thêm với AI Chef?) then ([Có])
  :Nhập câu hỏi/yêu cầu;
  |Hệ thống AI|
  :Phân tích ngữ cảnh và phản hồi;
  |Người dùng|
  :Xem phản hồi AI Chef;
else ([Không])
endif

|Hệ thống|
:Đối chiếu nguyên liệu công thức với Pantry;
if (Thiếu nguyên liệu?) then ([Có])
  |Người dùng|
  :Chọn thêm nguyên liệu thiếu vào List;
  |Hệ thống|
  :Cập nhật danh sách mua sắm;
else ([Không])
  |Người dùng|
  :Lưu hoặc bỏ lưu công thức nếu cần;
endif

:Kết thúc tra cứu/gợi ý món ăn;
stop
@enduml
