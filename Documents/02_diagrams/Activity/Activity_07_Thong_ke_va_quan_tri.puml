@startuml
title Activity Diagram - Quy trình thống kê và quản trị hệ thống

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor black
skinparam activity {
  BackgroundColor #FFF8CC
  BorderColor black
  FontColor black
  DiamondBackgroundColor #FFF8CC
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam partition {
  BackgroundColor white
  BorderColor black
  FontColor black
}

|Người dùng|
start
if (Tác nhân là Người dùng?) then ([Người dùng])
  :Mở chức năng thống kê;
  |Hệ thống|
  :Tổng hợp dữ liệu mua sắm,\n kho và thanh lý;
  :Tính toán tiêu dùng và lãng phí;
  |Người dùng|
  :Xem thống kê tiêu dùng và lãng phí;
else ([Quản trị viên])
  |Quản trị viên|
  :Đăng nhập vào khu vực quản trị;
  |Hệ thống|
  :Xác thực quyền quản trị;
  if (Có quyền quản trị?) then ([Có])
    |Quản trị viên|
    :Xem danh sách User;
    if (Cần khóa/mở khóa tài khoản?) then ([Có])
      :Chọn tài khoản và thao tác khóa/mở khóa;
      |Hệ thống|
      :Cập nhật trạng thái tài khoản;
    else ([Không])
    endif

    |Quản trị viên|
    if (Cần quản lý Master Data?) then ([Có])
      :Thêm/sửa/xóa dữ liệu nền;
      |Hệ thống|
      :Lưu thay đổi Master Data;
    else ([Không])
    endif

    |Quản trị viên|
    if (Có công thức cần kiểm duyệt?) then ([Có])
      :Duyệt hoặc từ chối công thức;
      |Hệ thống|
      :Cập nhật trạng thái công thức;
    else ([Không])
    endif

    |Quản trị viên|
    :Xem Dashboard tổng quan;
  else ([Không])
    |Quản trị viên|
    :Nhận thông báo không đủ quyền;
  endif
endif
stop
@enduml
